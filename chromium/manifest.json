{
  "manifest_version": 3,
  "name": "unteeco",
  "version": "1.0.0",
  "description": "Replace t.co tracking links on x.com / twitter.com with the original URLs, without contacting t.co.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "unteeco.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
